{
  "productName": "Plume",
  "version": "0.2.0",
  "identifier": "app.plume.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plume",
        "width": 1300,
        "height": 820,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../bin/tectonic": "tectonic"
    },
    "fileAssociations": [
      {
        "ext": [
          "tex"
        ],
        "name": "LaTeX document",
        "role": "Editor"
      }
    ]
  }
}